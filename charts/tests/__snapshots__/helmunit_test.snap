# Source: wxingress/templates/controller-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: default-listener-ports-no-crs-wxingress-controller
  namespace: default
  labels:
    helm.sh/chart: wxingress-2.8.1
    app.kubernetes.io/name: wxingress
    app.kubernetes.io/instance: default-listener-ports-no-crs
    app.kubernetes.io/version: "5.7.1-wx5"
    app.kubernetes.io/managed-by: Helm
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: wxingress
      app.kubernetes.io/instance: default-listener-ports-no-crs
  template:
    metadata:
      labels:
        app.kubernetes.io/name: wxingress
        app.kubernetes.io/instance: default-listener-ports-no-crs
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "9113"
        prometheus.io/scheme: "http"
    spec:
      volumes:
      - name: nginx-etc
        emptyDir: {}
      - name: nginx-lib
        emptyDir: {}
      - name: nginx-state
        emptyDir: {}
      - name: nginx-log
        emptyDir: {}
      - name: tmp
        emptyDir: {}
      - name: nginx-cache
        emptyDir: {}
      serviceAccountName: default-listener-ports-no-crs-wxingress
      automountServiceAccountToken: true
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      terminationGracePeriodSeconds: 30
      hostNetwork: false
      dnsPolicy: ClusterFirst
      containers:
      - image: ghcr.io/wx-one/wxingress:5.7.1-wx5
        name: wxingress
        imagePullPolicy: "IfNotPresent"
        ports:
        - name: http
          containerPort: 80
          protocol: TCP
        - name: https
          containerPort: 443
          protocol: TCP
        - name: prometheus
          containerPort: 9113
        - name: readiness-port
          containerPort: 8081
        readinessProbe:
          httpGet:
            path: /nginx-ready
            port: readiness-port
          periodSeconds: 1
          initialDelaySeconds: 0
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsUser: 101 #nginx
          runAsNonRoot: true
          seccompProfile:
            type: RuntimeDefault
          capabilities:
            drop:
            - ALL
            add:
            - NET_BIND_SERVICE
        volumeMounts:
        - mountPath: /etc/nginx
          name: nginx-etc
        - mountPath: /var/cache/nginx
          name: nginx-cache
        - mountPath: /var/lib/nginx
          name: nginx-lib
        - mountPath: /var/lib/nginx/state
          name: nginx-state
        - mountPath: /var/log/nginx
          name: nginx-log
        - mountPath: /tmp
          name: tmp
        env:
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: POD_NAME
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        args:
          - -nginx-plus=false
          - -dynamic-upstreams=false
          - -ingress-nginx-defaults=false
          - -nginx-reload-timeout=60000
          - -enable-app-protect=false
          - -enable-app-protect-ip-intelligence=false
          - -enable-app-protect-dos=false
          - -nginx-configmaps=$(POD_NAMESPACE)/default-listener-ports-no-crs-wxingress
          - -ingress-class=nginx
          - -ingress-class-controllers=nginx.wx1.eu/ingress-controller
          - -watch-ingress-without-class=true
          - -health-status=false
          - -health-status-uri=/nginx-health
          - -nginx-debug=false
          - -log-level=info
          - -log-format=glog
          - -enable-config-safety=false
          - -nginx-status=true
          - -nginx-status-port=8080
          - -nginx-status-allow-cidrs=127.0.0.1
          - -report-ingress-status
          - -external-service=default-listener-ports-no-crs-wxingress-controller
          - -enable-leader-election=true
          - -leader-election-lock-name=default-listener-ports-no-crs-wxingress-leader-election
          - -enable-prometheus-metrics=true
          - -prometheus-metrics-listen-port=9113
          - -prometheus-tls-secret=
          - -enable-service-insight=false
          - -service-insight-listen-port=9114
          - -service-insight-tls-secret=
          - -enable-custom-resources=false
          - -enable-snippets=false
          - -disable-ipv6=false
          - -default-http-listener-port=8080
          - -default-https-listener-port=8443
          - -allow-empty-ingress-host=false
          - -ready-status=true
          - -ready-status-port=8081
          - -enable-latency-metrics=false
          - -enable-topology-aware-routing=false
          - -ssl-dynamic-reload=true
          - -enable-telemetry-reporting=false
          - -weight-changes-dynamic-reload=false
      initContainers:
      - name: init-wxingress
        image: ghcr.io/wx-one/wxingress:5.7.1-wx5
        imagePullPolicy: "IfNotPresent"
        # the image has no shell and no cp: the controller's copy subcommand
        command: ['/nginx-ingress', 'copy', '/etc/nginx', '/mnt/etc']
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsUser: 101 #nginx
          runAsNonRoot: true
          seccompProfile:
            type: RuntimeDefault
          # /nginx-ingress carries the file capability cap_net_bind_service,
          # and the kernel refuses to run it where the bounding set lacks it
          capabilities:
            drop:
            - ALL
            add:
            - NET_BIND_SERVICE
        volumeMounts:
        - mountPath: /mnt/etc
          name: nginx-etc
