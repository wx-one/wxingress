# Source: wxingress/templates/controller-globalconfiguration.yaml
apiVersion: k8s.nginx.org/v1
kind: GlobalConfiguration
metadata:
  name: my-custom-global-config
  namespace: test-namespace
  labels:
    helm.sh/chart: wxingress-2.8.1
    app.kubernetes.io/name: wxingress
    app.kubernetes.io/instance: global-config-custom-name
    app.kubernetes.io/version: "5.7.1-wx5"
    app.kubernetes.io/managed-by: Helm
spec:
  listeners:
  - name: dns-udp
    port: 5353
    protocol: UDP
