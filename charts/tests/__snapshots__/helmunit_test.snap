apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: compat-kube-129-wxingress-controller
  namespace: default
  labels:
    helm.sh/chart: wxingress-2.8.1
    app.kubernetes.io/name: wxingress
    app.kubernetes.io/instance: compat-kube-129
    app.kubernetes.io/version: "5.7.1-wx5"
    app.kubernetes.io/managed-by: Helm
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: wxingress
      app.kubernetes.io/instance: compat-kube-129
  template:
    metadata:
      labels:
        app.kubernetes.io/name: wxingress
        app.kubernetes.io/instance: compat-kube-129
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "9113"
        prometheus.io/scheme: "http"
    spec:
      serviceAccountName: compat-kube-129-wxingress
      automountServiceAccountToken: true
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      terminationGracePeriodSeconds: 30
      volumes:
      - name: nginx-etc
        emptyDir: {}
      - name: nginx-lib
        emptyDir: {}
      - name: nginx-state
        emptyDir: {}
      - name: nginx-log
        emptyDir: {}
      - name: tmp
        emptyDir: {}
      - name: nginx-cache
        emptyDir: {}
      - name: webhook-cert
        secret:
          secretName: compat-kube-129-wxingress-controller-admission
      hostNetwork: false
      dnsPolicy: ClusterFirst
      containers:
      - name: wxingress
        image: ghcr.io/wx-one/wxingress:5.7.1-wx5
        imagePullPolicy: "IfNotPresent"
        lifecycle:
          preStop:
            exec:
              command: ["/nginx-ingress", "sleep", "5"]
        ports:
        - name: http
          containerPort: 80
          protocol: TCP
        - name: https
          containerPort: 443
          protocol: TCP
        - name: prometheus
          containerPort: 9113
        - name: readiness-port
          containerPort: 8081
        - name: webhook
          containerPort: 8443
          protocol: TCP
        readinessProbe:
          httpGet:
            path: /nginx-ready
            port: readiness-port
          periodSeconds: 1
          initialDelaySeconds: 0
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsUser: 101 #nginx
          runAsNonRoot: true
          seccompProfile:
            type: RuntimeDefault
          capabilities:
            drop:
            - ALL
            add:
            - NET_BIND_SERVICE
        volumeMounts:
        - mountPath: /etc/nginx
          name: nginx-etc
        - mountPath: /var/cache/nginx
          name: nginx-cache
        - mountPath: /var/lib/nginx
          name: nginx-lib
        - mountPath: /var/lib/nginx/state
          name: nginx-state
        - mountPath: /var/log/nginx
          name: nginx-log
        - mountPath: /tmp
          name: tmp
        - name: webhook-cert
          mountPath: /usr/local/certificates
          readOnly: true
        env:
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: POD_NAME
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
        args:
          - -nginx-plus=false
          - -dynamic-upstreams=true
          - -sync-rate-limit=0.3
          - -ingress-nginx-defaults=true
          - -validating-webhook=:8443
          - -validating-webhook-certificate=/usr/local/certificates/cert
          - -validating-webhook-key=/usr/local/certificates/key
          - -validating-webhook-nginx-test=true
          - -nginx-reload-timeout=60000
          - -enable-app-protect=false
          - -enable-app-protect-ip-intelligence=false
          - -enable-app-protect-dos=false
          - -nginx-configmaps=$(POD_NAMESPACE)/compat-kube-129-wxingress
          - -ingress-class=nginx
          - -ingress-class-controllers=nginx.wx1.eu/ingress-controller
          - -watch-ingress-without-class=true
          - -health-status=false
          - -health-status-uri=/nginx-health
          - -nginx-debug=false
          - -log-level=info
          - -log-format=glog
          - -enable-config-safety=false
          - -nginx-status=true
          - -nginx-status-port=8080
          - -nginx-status-allow-cidrs=127.0.0.1
          - -report-ingress-status
          - -external-service=compat-kube-129-wxingress-controller
          - -enable-leader-election=true
          - -leader-election-lock-name=compat-kube-129-wxingress-leader-election
          - -enable-prometheus-metrics=true
          - -prometheus-metrics-listen-port=9113
          - -prometheus-tls-secret=
          - -enable-service-insight=false
          - -service-insight-listen-port=9114
          - -service-insight-tls-secret=
          - -enable-custom-resources=true
          - -enable-snippets=false
          - -disable-ipv6=false
          - -enable-tls-passthrough=false
          - -enable-cert-manager=false
          - -enable-oidc=false
          - -enable-external-dns=false
          - -default-http-listener-port=80
          - -default-https-listener-port=443
          - -allow-empty-ingress-host=true
          - -ready-status=true
          - -ready-status-port=8081
          - -enable-latency-metrics=false
          - -enable-topology-aware-routing=false
          - -ssl-dynamic-reload=true
          - -enable-telemetry-reporting=false
          - -weight-changes-dynamic-reload=false
      initContainers:
      - name: init-wxingress
        image: ghcr.io/wx-one/wxingress:5.7.1-wx5
        imagePullPolicy: "IfNotPresent"
        # the image has no shell and no cp: the controller's copy subcommand
        command: ['/nginx-ingress', 'copy', '/etc/nginx', '/mnt/etc']
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsUser: 101 #nginx
          runAsNonRoot: true
          seccompProfile:
            type: RuntimeDefault
          # /nginx-ingress carries the file capability cap_net_bind_service,
          # and the kernel refuses to run it where the bounding set lacks it
          capabilities:
            drop:
            - ALL
            add:
            - NET_BIND_SERVICE
        volumeMounts:
        - mountPath: /mnt/etc
          name: nginx-etc
