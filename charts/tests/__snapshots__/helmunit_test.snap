# Source: wxingress/templates/admission-webhooks/validating-webhook.yaml
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingWebhookConfiguration
metadata:
  labels:
    helm.sh/chart: wxingress-2.8.1
    app.kubernetes.io/name: wxingress
    app.kubernetes.io/instance: admission-webhooks
    app.kubernetes.io/version: "5.7.1-wx5"
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/component: admission-webhook
  name: admission-webhooks-wxingress-controller-admission
webhooks:
  - name: validate.wxingress.wizardtales.com
    matchPolicy: Equivalent
    rules:
      - apiGroups:
          - networking.k8s.io
        apiVersions:
          - v1
        operations:
          - CREATE
          - UPDATE
        resources:
          - ingresses
    failurePolicy: Fail
    sideEffects: None
    admissionReviewVersions:
      - v1
    clientConfig:
      service:
        name: admission-webhooks-wxingress-controller-admission
        namespace: default
        port: 443
        path: /networking/v1/ingresses
    timeoutSeconds: 5
    namespaceSelector:
      matchExpressions:
      - key: kubernetes.io/metadata.name
        operator: NotIn
        values:
        - kube-system
