# Source: wxingress/templates/admission-webhooks/networkpolicy.yaml
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: admission-webhooks-network-policy-wxingress-controller-admissio
  namespace: default
  labels:
    helm.sh/chart: wxingress-2.8.1
    app.kubernetes.io/name: wxingress
    app.kubernetes.io/instance: admission-webhooks-network-policy
    app.kubernetes.io/version: "5.7.1-wx5"
    app.kubernetes.io/managed-by: Helm
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: wxingress
      app.kubernetes.io/instance: admission-webhooks-network-policy
  policyTypes:
    - Ingress
  ingress:
    # the webhook, from the API server only
    - from:
        - ipBlock:
            cidr: 10.0.0.0/24
      ports:
        - protocol: TCP
          port: 8443
    # every other port, from everybody
    - ports:
        - protocol: TCP
          port: 1
          endPort: 8442
        - protocol: TCP
          port: 8444
          endPort: 65535
        - protocol: UDP
          port: 1
          endPort: 65535
---

