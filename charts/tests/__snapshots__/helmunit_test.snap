kind: RoleBinding
apiVersion: rbac.authorization.k8s.io/v1
metadata:
  name: plus-mgmt-proxy-host-wxingress
  labels:
    helm.sh/chart: wxingress-2.8.1
    app.kubernetes.io/name: wxingress
    app.kubernetes.io/instance: plus-mgmt-proxy-host
    app.kubernetes.io/version: "5.7.1-wx5"
    app.kubernetes.io/managed-by: Helm
  namespace: default
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: plus-mgmt-proxy-host-wxingress
subjects:
- kind: ServiceAccount
  name: plus-mgmt-proxy-host-wxingress
  namespace: default
