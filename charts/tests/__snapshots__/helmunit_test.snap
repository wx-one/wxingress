apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingWebhookConfiguration
metadata:
  annotations:
    cert-manager.io/inject-ca-from: "default/admission-webhooks-cert-manager-wxingress-controller-admission"
  labels:
    helm.sh/chart: wxingress-2.8.1
    app.kubernetes.io/name: wxingress
    app.kubernetes.io/instance: admission-webhooks-cert-manager
    app.kubernetes.io/version: "5.7.1-wx5"
