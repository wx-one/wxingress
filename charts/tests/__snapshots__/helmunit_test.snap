        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsUser: 101 #nginx
          runAsNonRoot: true
          seccompProfile:
            type: RuntimeDefault
          capabilities:
            drop:
            - ALL
            add:
            - NET_BIND_SERVICE
        volumeMounts:
        - mountPath: /etc/nginx
          name: nginx-etc
        - mountPath: /var/cache/nginx
          name: nginx-cache
        - mountPath: /var/lib/nginx
          name: nginx-lib
        - mountPath: /var/lib/nginx/state
          name: nginx-state
        - mountPath: /var/log/nginx
          name: nginx-log
        - mountPath: /tmp
          name: tmp
        env:
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: POD_NAME
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        args:
          - -nginx-plus=true
          - -dynamic-upstreams=false
          - -ingress-nginx-defaults=false
          - -nginx-reload-timeout=60000
          - -enable-app-protect=false
          - -enable-app-protect-ip-intelligence=false
          - -enable-app-protect-dos=true
          - -app-protect-dos-debug=true
          - -app-protect-dos-max-daemons=10
          - -app-protect-dos-max-workers=5
          - -app-protect-dos-memory=1024
          - -nginx-configmaps=$(POD_NAMESPACE)/appprotect-dos-wxingress
          - -mgmt-configmap=$(POD_NAMESPACE)/appprotect-dos-wxingress-mgmt
          - -ingress-class=nginx
          - -ingress-class-controllers=nginx.wx1.eu/ingress-controller
          - -watch-ingress-without-class=true
          - -health-status=false
          - -health-status-uri=/nginx-health
          - -nginx-debug=false
          - -log-level=info
          - -log-format=glog
          - -enable-config-safety=false
          - -nginx-status=true
          - -nginx-status-port=8080
          - -nginx-status-allow-cidrs=127.0.0.1
          - -report-ingress-status
