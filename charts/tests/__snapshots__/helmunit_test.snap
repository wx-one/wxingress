          runAsUser: 101 #nginx
          runAsNonRoot: true
          seccompProfile:
            type: RuntimeDefault
          # /nginx-ingress carries the file capability cap_net_bind_service,
          # and the kernel refuses to run it where the bounding set lacks it
          capabilities:
            drop:
            - ALL
            add:
            - NET_BIND_SERVICE
        volumeMounts:
        - mountPath: /mnt/etc
          name: nginx-etc
