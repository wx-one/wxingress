          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: PROXY_USER
          valueFrom:
            secretKeyRef:
              name: custom-credentials
              key: username
        - name: PROXY_PASS
          valueFrom:
            secretKeyRef:
              name: custom-credentials
              key: password
        args:
          - -nginx-plus=true
          - -dynamic-upstreams=false
          - -ingress-nginx-defaults=false
          - -nginx-reload-timeout=60000
