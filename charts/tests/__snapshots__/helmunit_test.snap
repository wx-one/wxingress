    protocol: UDP
    targetPort: 9001
  - port: 80
    targetPort: 80
    protocol: TCP
    name: http
  - port: 443
    targetPort: 443
    protocol: TCP
    name: https
  selector:
    app.kubernetes.io/name: wxingress
    app.kubernetes.io/instance: list-configs
  externalIPs:
    - 203.0.113.1
    - 203.0.113.2
