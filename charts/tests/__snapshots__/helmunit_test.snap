apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: deployment-hpa-wxingress-controller
  namespace: default
  labels:
    helm.sh/chart: wxingress-2.8.1
    app.kubernetes.io/name: wxingress
    app.kubernetes.io/instance: deployment-hpa
    app.kubernetes.io/version: "5.7.1-wx5"
    app.kubernetes.io/managed-by: Helm
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: deployment-hpa-wxingress-controller
  minReplicas: 1
  maxReplicas: 3
  metrics:
    - type: Resource
      resource:
        name: memory
        target:
          type: Utilization
          averageUtilization: 50
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 50
