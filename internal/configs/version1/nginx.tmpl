{{- /*gotype: github.com/wx-one/wxingress/internal/configs/version1.MainConfig*/ -}}
worker_processes  {{.WorkerProcesses}};
{{- if .WorkerRlimitNofile}}
worker_rlimit_nofile {{.WorkerRlimitNofile}};{{end}}
{{- if .WorkerCPUAffinity}}
worker_cpu_affinity {{.WorkerCPUAffinity}};{{end}}
{{- if .WorkerShutdownTimeout}}
worker_shutdown_timeout {{.WorkerShutdownTimeout}};{{end}}
daemon off;

error_log  stderr {{.ErrorLogLevel}};
pid        /var/lib/nginx/nginx.pid;

{{- if .MainOtelLoadModule}}
load_module modules/ngx_otel_module.so;
{{- end}}

{{- range $value := .MainSnippets}}
{{$value}}{{- end}}

{{- if .UpstreamAPI}}
{{- /* the wxingress module computes what njs did (compat.c): no njs */}}
load_module modules/ngx_http_wxingress_module.so;
{{- else}}
load_module modules/ngx_http_js_module.so;
{{- end}}

events {
    worker_connections  {{.WorkerConnections}};
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    map_hash_max_size {{.MapHashMaxSize}};
    map_hash_bucket_size {{.MapHashBucketSize}};

    {{- if .UpstreamAPI }}
    # what the wxingress module reads for jwt and oidc Policies, "" where a
    # server or location does not set it - without a warning about an
    # uninitialized variable on every request
    map "" $wxingress_jwt_realm { default ""; }
    map "" $wxingress_jwt_keys { default ""; }
    map "" $wxingress_jwt_jwks { default ""; }
    map "" $wxingress_jwt_cache { default ""; }
    map "" $wxingress_jwt_ca { default ""; }
    map "" $wxingress_jwt_token_from { default ""; }
    map "" $wxingress_jwt_leeway { default ""; }
    map "" $wxingress_oidc_client { default ""; }
    map "" $wxingress_oidc_client_secret { default ""; }
    map "" $wxingress_oidc_session_key_file { default ""; }
    map "" $wxingress_oidc_auth { default ""; }
    map "" $wxingress_oidc_token { default ""; }
    map "" $wxingress_oidc_jwks { default ""; }
    map "" $wxingress_oidc_end_session { default ""; }
    map "" $wxingress_oidc_scope { default ""; }
    map "" $wxingress_oidc_redirect { default ""; }
    map "" $wxingress_oidc_post_logout { default ""; }
    map "" $wxingress_oidc_extra { default ""; }
    map "" $wxingress_oidc_pkce { default ""; }
    map "" $wxingress_oidc_ca { default ""; }
    map "" $wxingress_oidc_leeway { default ""; }
    map "" $wxingress_oidc_on { default ""; }
    map "" $wxingress_oidc_issuer { default ""; }
    map "" $wxingress_oidc_verify { default ""; }
    map "" $wxingress_jwt_verify { default ""; }
    map "" $wxingress_jwt_sni { default ""; }
    {{- end }}

    {{- if .ClientBodyBufferSize }}
    client_body_buffer_size {{.ClientBodyBufferSize}};
    {{- end }}

    {{- if .UpstreamAPI}}
    # the hash of an APIKey Policy and the variables of ingress-nginx for its
    # annotations, from the wxingress module
    map $host $apikey_auth_hash {
        default $meta_ingress_nginx_apikey_hash;
    }
    map $host $escaped_request_uri {
        default $meta_ingress_nginx_escaped_request_uri;
    }
    {{- else}}
    js_import /etc/nginx/njs/apikey_auth.js;
    js_set $apikey_auth_hash apikey_auth.hash;

    # variables of ingress-nginx for its annotations
    js_import /etc/nginx/njs/ingress_nginx.js;
    js_set $escaped_request_uri ingress_nginx.escapedRequestURI;
    {{- end}}
    # HSTS of a server whose $hsts_header_value is set: over https, or
    # behind a proxy that says https - a map, so that the servers need no if
    # (each if is a location, some 10 kB of configuration a server)
    map "" $hsts_header_value {
        default "";
    }
    map $https $hsts_header {
        on $hsts_header_value;
        default "";
    }
    map $http_x_forwarded_proto $hsts_header_behind_proxy {
        https $hsts_header_value;
        default "";
    }
    map $http_x_request_id $ingress_nginx_req_id {
        default $http_x_request_id;
        "" $request_id;
    }
    # SameSite=None, but not for the browsers that reject it (session-cookie-conditional-samesite-none of ingress-nginx)
    map $http_user_agent $ingress_nginx_samesite_none {
        "~Chrome/[4-6]" "";
        "~CPU iPhone OS 12" "";
        "~iPad; CPU OS 12" "";
        "~Chrome" none;
        "~^(?=.*Macintosh)(?=.*Intel Mac OS X 10_14)(?=.*Safari)" "";
        default none;
    }

    {{- range $value := .HTTPSnippets}}
    {{$value}}{{- end}}

    {{- range $h := .AddHeaders}}
    add_header {{$h.Name}} {{ printf "%q" $h.Value }}{{if $h.Always}} always{{end}};
    {{- end}}

    {{if .LogFormat -}}
    log_format  main {{if .LogFormatEscaping}}escape={{ .LogFormatEscaping }} {{end}}
                     {{range $i, $value := .LogFormat -}}
                     {{with $value}}'{{if $i}} {{end}}{{$value}}'
                     {{end}}{{end}};
    {{- else -}}
    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';
    {{- end}}

    map $upstream_trailer_grpc_status $grpc_status {
        default $upstream_trailer_grpc_status;
        '' $sent_http_grpc_status;
    }

    {{- if .DynamicSSLReloadEnabled }}
    map $nginx_version $secret_dir_path {
        default "{{ .StaticSSLPath }}";
    }

    # Certificates named through a variable are read at the handshake. Cached,
    # each worker parses a certificate once and looks at its file again after
    # five seconds - a Secret that changed is served then, without a reload.
    ssl_certificate_cache max=1000 inactive=60s valid=5s;
    proxy_ssl_certificate_cache max=1000 inactive=60s valid=5s;
    grpc_ssl_certificate_cache max=1000 inactive=60s valid=5s;
    {{- end }}
    access_log {{.AccessLog}};

    {{- if .AddHeaderInherit}}
    add_header_inherit {{.AddHeaderInherit}};
    {{- end}}

    {{- if .LatencyMetrics}}
    log_format response_time '{"upstreamAddress":"$upstream_addr", "upstreamResponseTime":"$upstream_response_time", "proxyHost":"$proxy_host", "upstreamStatus": "$upstream_status"}';
    access_log syslog:server=unix:/var/lib/nginx/nginx-syslog.sock,nohostname,tag=nginx response_time;
    {{- end}}

    sendfile        on;
    #tcp_nopush     on;

    keepalive_timeout {{.KeepaliveTimeout}};
    keepalive_requests {{.KeepaliveRequests}};

    {{- if .HTTP2}}
    http2 on;
    {{- end}}

    #gzip  on;

    server_names_hash_max_size {{.ServerNamesHashMaxSize}};
    {{if .ServerNamesHashBucketSize}}server_names_hash_bucket_size {{.ServerNamesHashBucketSize}};{{end}}

    variables_hash_bucket_size {{.VariablesHashBucketSize}};
    variables_hash_max_size {{.VariablesHashMaxSize}};

    map $request_uri $request_uri_no_args {
        "~^(?P<path>[^?]*)(\?.*)?$" $path;
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }
    # a "$" in a header value of ingress-nginx's custom-headers, as ingress-nginx has it (geo values are no variables)
    geo $literal_dollar {
        default "$";
    }
    # ingress-nginx's redirect to https: the Host header without its port, the URI without a trailing slash
    map $http_host $ingress_nginx_redirect_host {
        "~^(?<ingress_nginx_h>[^:]+)" $ingress_nginx_h;
        default                     $host;
    }
    map $request_uri $ingress_nginx_redirect_uri {
        "~^(?<ingress_nginx_u>.*)/$" $ingress_nginx_u;
        default                     $request_uri;
    }
    # ingress-nginx's Connection to an upstream with keepalive: upgrade for WebSocket, else kept alive
    map $http_upgrade $ingress_nginx_connection_upgrade {
        default upgrade;
        ''      '';
    }
    map $http_upgrade $default_connection_header {
        default "";
    }
    map $http_host $resource_type {
        default "";
    }
    map $http_host $resource_name {
        default "";
    }
    map $http_host $resource_namespace {
        default "";
    }
    map $http_host $service {
        default "";
    }
    map $http_upgrade $vs_connection_header {
        default upgrade;
        ''      $default_connection_header;
    }
    {{- if .UseForwardedHeaders }}
    map $http_x_forwarded_host $forwarded_host {
        default $host;
        "~^[ \t]*([^, \t]+)" $1;
    }
    map $http_x_forwarded_port $forwarded_port {
        default $server_port;
        "~^[ \t]*([^, \t]+)" $1;
    }
    map $http_x_forwarded_proto $forwarded_proto {
        default $scheme;
        "~^[ \t]*([^, \t]+)" $1;
    }
    {{- end }}
    {{- if .SSLProtocols}}
    ssl_protocols {{.SSLProtocols}};
    {{- end}}
    {{- if .SSLCiphers}}
    ssl_ciphers {{ printf "%q" .SSLCiphers }};
    {{- end}}
    {{- if .SSLPreferServerCiphers}}
    ssl_prefer_server_ciphers on;
    {{- end}}
    {{- if .SSLDHParam}}
    ssl_dhparam {{.SSLDHParam}};
    {{- end}}

    {{- if .MainOtelLoadModule }}
    otel_exporter {
        endpoint {{ .MainOtelExporterEndpoint }};
        {{- if and .MainOtelExporterHeaderName .MainOtelExporterHeaderValue }}
        header {{ .MainOtelExporterHeaderName }} "{{ .MainOtelExporterHeaderValue }}";
        {{- end }}
    }

    {{- if .MainOtelServiceName}}
    otel_service_name {{ printf "%q" .MainOtelServiceName }};
    {{- end }}
    {{- if .MainOtelGlobalTraceEnabled }}
    otel_trace on;
    {{- end}}
    {{- if .MainOtelTraceContext}}
    otel_trace_context {{ .MainOtelTraceContext }};
    {{- end}}
    {{- end}}
    {{- if .NginxStatus}}
    # stub_status
    server {
        listen {{.NginxStatusPort}};
        {{if not .DisableIPV6}}listen [::]:{{.NginxStatusPort}};{{end}}

        {{range $value := .NginxStatusAllowCIDRs}}
        allow {{$value}};{{end}}

        deny all;
        location /stub_status {
            stub_status;
        }
    }
    {{- end}}

    {{- if .StubStatusOverUnixSocketForOSS }}
    server {
        listen unix:/var/lib/nginx/nginx-status.sock;
        access_log off;

        location /stub_status {
            stub_status;
        }
    }
    {{- end}}

    {{- if .UpstreamAPI}}
    # the upstream API of the wxingress module, on the socket NGINX Plus has its own on
    server {
        listen unix:/var/lib/nginx/nginx-plus-api.sock;
        access_log off;

        location /configVersionCheck {
            if ($config_version_mismatch) {
                return 503;
            }
            return 200;
        }

        location /api {
            meta_pass;
        }
    }
    {{- end}}

    include /etc/nginx/config-version.conf;
    include /etc/nginx/conf.d/*.conf;

    server {
        listen unix:/var/lib/nginx/nginx-502-server.sock;
        access_log off;

        return 502;
    }

    server {
        listen unix:/var/lib/nginx/nginx-418-server.sock;
        access_log off;

        return 418;
    }
}

stream {
    {{if .StreamLogFormat -}}
    log_format  stream-main {{if .StreamLogFormatEscaping}}escape={{ .StreamLogFormatEscaping }} {{end}}
                            {{range $i, $value := .StreamLogFormat -}}
                            {{with $value}}'{{if $i}} {{end}}{{$value}}'
                            {{end}}{{end}};
    {{- else -}}
    log_format  stream-main  '$remote_addr [$time_local] '
                      '$protocol $status $bytes_sent $bytes_received '
                      '$session_time "$ssl_preread_server_name"';
    {{- end}}

    access_log  /dev/stdout  stream-main;

    {{- range $value := .StreamSnippets}}
    {{$value}}{{end}}

    map_hash_max_size {{.MapHashMaxSize}};
    {{if .MapHashBucketSize}}map_hash_bucket_size {{.MapHashBucketSize}};{{end}}

    {{- if .DynamicSSLReloadEnabled }}
    map $nginx_version $secret_dir_path {
        default "{{ .StaticSSLPath }}";
    }
    {{- end }}

    {{- if .TLSPassthrough}}
    map $ssl_preread_server_name $dest_internal_passthrough  {
        default unix:/var/lib/nginx/passthrough-https.sock;
        include /etc/nginx/tls-passthrough-hosts.conf;
    }

    server {
        listen {{.TLSPassthroughPort}}{{if .ProxyProtocol}} proxy_protocol{{end}};
        {{if not .DisableIPV6}}listen [::]:{{.TLSPassthroughPort}}{{if .ProxyProtocol}} proxy_protocol{{end}};{{end}}


        {{if .ProxyProtocol}}
        {{range $setRealIPFrom := .SetRealIPFrom}}
        set_real_ip_from {{$setRealIPFrom}};{{end}}
        {{end}}

        ssl_preread on;

        proxy_protocol on;
        proxy_pass $dest_internal_passthrough;
    }
    {{end}}

    include /etc/nginx/stream-conf.d/*.conf;
}
